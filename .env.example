# ─────────────────────────────────────────────────────────────────────────────
# Millésime Coffee Bot — variables d'environnement
# Copiez ce fichier en `.env` et remplissez les VRAIES valeurs.
# NE COMMIT JAMAIS le fichier `.env` (gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram Bot (obligatoire) ─────────────────────────────────────────────
BOT_TOKEN=put_your_bot_token_here
BOT_PASSWORD=choose_a_strong_password
OWNER_CHAT_ID=your_telegram_user_or_group_id
OWNER_USER_ID=your_personal_telegram_user_id
# Username Telegram du vendeur (sans @) — pour le bouton "Nous contacter"
# du suivi de commande. Si vide, repli sur un deep-link vers OWNER_USER_ID.
SUPPORT_USERNAME=

# ── Compte personnel admin via Telethon (optionnel) ────────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# ── WebApp selfie (un seul à remplir) ──────────────────────────────────────
WEBAPP_URL=
NGROK_AUTH_TOKEN=

# ── Adresse / autocomplétion ───────────────────────────────────────────────
# Si defini : Mapbox (meilleure couverture). Sinon repli automatique sur Photon (OSM, gratuit).
# Token public Mapbox (format pk.xxxxx) — dashboard Mapbox > Access tokens.
MAPBOX_TOKEN=

# ── Stockage persistant ────────────────────────────────────────────────────
# Option A : Supabase
SUPABASE_URL=
SUPABASE_KEY=
# Option B : backup vers repo GitHub privé
GITHUB_TOKEN=
GITHUB_DATA_OWNER=
GITHUB_DATA_REPO=coffee-bot-data
GITHUB_DATA_BRANCH=main
DATA_DIR=

# ── Paiement (optionnels) ──────────────────────────────────────────────────
PAYMENT_LINK=
CRYPTO_ETH=
CRYPTO_USDT=

# ── Notifications Pushover (optionnel) ─────────────────────────────────────
# Canal de secours à côté de Telegram : sonne comme une alarme et passe le
# mode silencieux, pour ne pas rater une commande noyée dans les conversations.
# Les DEUX sont nécessaires ; si l'un manque, aucune notification n'est envoyée.
# Clé utilisateur : tableau de bord pushover.net
PUSHOVER_USER_KEY=
# Jeton d'application : pushover.net > Create an Application/API Token
PUSHOVER_APP_TOKEN=

# ── Photos de ville (optionnel) ────────────────────────────────────────────
# Clé Pexels : télécharge automatiquement une photo pour les villes qui n'en
# ont pas encore dans cityimg/. Sans clé, repli sur un visuel synthétique.
PEXELS_API_KEY=

# ── Sécurité (optionnel — valeurs par défaut sûres) ────────────────────────
# Mot de passe du panneau admin — 2e barrière APRÈS la vérification de
# l'identité Telegram. Protège si le téléphone de l'owner est déverrouillé.
# Laisser VIDE désactive le verrou : le panel se comporte comme avant.
# La saisie tolère la casse et les espaces superflus (frappe au téléphone) ;
# préférez donc une phrase longue plutôt qu'un mot court à casse compliquée.
ADMIN_PANEL_PASSWORD=
# Durée d'une session admin avant nouvelle saisie, en secondes (défaut 8 h).
ADMIN_SESSION_TTL=28800
# Durée de validité d'un initData Telegram, en secondes (anti-rejeu). 0 = off.
INITDATA_MAX_AGE=86400
# Nombre de proxys de confiance devant l'app (Render = 1). Pour l'IP client réelle.
TRUSTED_PROXY_HOPS=1

# ── Divers ────────────────────────────────────────────────────────────────
PORT=5000

# ═══════════════════════════════════════════════════════════════════════════
# ACCÈS LIVREUR
# ═══════════════════════════════════════════════════════════════════════════
# Un livreur ne voit QUE les courses de ses zones, ne reçoit QUE les
# notifications de ses zones, et n'a aucune coordonnée de client : ni pseudo
# Telegram, ni numéro. Il parle au client par la messagerie de l'application.
#
# ZONES  : « Pays:Ville » séparés par des virgules. Sans ville, tout le pays.
# CHAT_ID: identifiants Telegram autorisés à ouvrir CET accès. Laisser vide
#          le temps d'inscrire le livreur (le premier qui a le mot de passe
#          entre), puis y mettre son identifiant : un mot de passe qui fuite
#          ne donne alors plus accès à rien.
# USERNAME: son @pseudo, pour le reconnaître dès qu'il écrit au bot.
#
# Pour ajouter un livreur : LIVREUR3_*, LIVREUR4_*… jusqu'à LIVREUR9_*.

LIVREUR_PASSWORD=mot_de_passe_du_livreur_1
LIVREUR_ZONES=Belgique:Bruxelles
LIVREUR_CHAT_ID=
LIVREUR_USERNAME=

LIVREUR2_PASSWORD=mot_de_passe_du_livreur_2
LIVREUR2_ZONES=Espagne:Barcelone, Espagne:Marbella, Espagne:Malaga
LIVREUR2_CHAT_ID=
LIVREUR2_USERNAME=

# ═══════════════════════════════════════════════════════════════════════════
# ACCÈS DE VEILLE
# ═══════════════════════════════════════════════════════════════════════════
# Un mot de passe qui n'ouvre qu'un seul écran : la liste des gens qui
# consultent le catalogue, avec le pays et la ville qu'ils regardent.
# Rien d'autre — ni commandes, ni conversations, ni panneau, ni catalogue,
# ni prix. Sa réponse d'authentification ne contient que de quoi ouvrir son
# écran, et le veilleur n'apparaît pas dans sa propre liste.
# Laisser vide désactive complètement le rôle.
# VEILLE_CHAT_ID : comptes Telegram qui reçoivent les notifications de veille.
# Laisser vide : les comptes qui ouvrent l'accès s'y inscrivent tout seuls.
# Un bot ne peut écrire qu'à quelqu'un qui l'a démarré au moins une fois.
VEILLE_CHAT_ID=
VEILLE_PASSWORD=
